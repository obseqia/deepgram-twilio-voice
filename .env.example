# Obligatorio: tu API key de Deepgram (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Servidor
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info

# URL pública del websocket que Twilio debe abrir.
# Si se deja vacía, /twiml la deriva del header Host de la petición
# (funciona directamente con ngrok). Ejemplo: wss://abc123.ngrok.app/twilio
PUBLIC_WS_URL=

# El agente atiende en español e inglés y cambia según le hablen.
AGENT_GREETING=Hello! ¿En qué puedo ayudarte? How can I help you today?
AGENT_PROMPT=You are a helpful AI assistant focused on customer service. Keep your answers short and conversational, you are speaking over the phone.

# LLM: modelos propios en DigitalOcean Serverless Inference.
# Modelos a comparar (openai-gpt-4o-mini es el baseline):
#   openai-gpt-4o-mini
#   anthropic-claude-haiku-4.5
#   openai-gpt-5.6-luna
#   mimo-v2.5
# Mira cuáles tienes disponibles con:  pnpm models
# Pon THINK_PROVIDER=deepgram para volver al LLM que incluye Deepgram.
THINK_PROVIDER=digitalocean
THINK_MODEL=openai-gpt-4o-mini
THINK_TEMPERATURE=0.7

# Se crea en Gradient AI -> Serverless Inference -> Model access keys.
# Ojo: quien llama al LLM es Deepgram, así que esta clave viaja hasta ellos.
DIGITALOCEAN_MODEL_ACCESS_KEY=

# Voz. Solo estas cinco alternan español e inglés dentro de una misma frase:
#   aura-2-aquila-es   masculina — expresiva, entusiasta, cercana
#   aura-2-carina-es   femenina  — profesional, enérgica, segura
#   aura-2-diana-es    femenina  — profesional, expresiva, resolutiva
#   aura-2-javier-es   masculina — cercana, profesional, tranquila
#   aura-2-selena-es   femenina  — natural, amable, cercana
SPEAK_MODEL=aura-2-diana-es

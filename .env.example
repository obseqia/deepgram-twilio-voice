# Obligatorio: tu API key de Deepgram (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Servidor
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info

# URL pública del websocket que Twilio debe abrir.
# Si se deja vacía, /twiml la deriva del header Host de la petición
# (funciona directamente con ngrok). Ejemplo: wss://abc123.ngrok.app/twilio
PUBLIC_WS_URL=

# Idiomas que el agente entiende y habla, separados por coma.
# Con más de uno se usa flux-general-multi con language hints y la voz
# tiene que ser una de las que hacen code-switching (ver SPEAK_MODEL).
AGENT_LANGUAGES=en,es

AGENT_GREETING=Hello! ¿En qué puedo ayudarte? How can I help you today?
AGENT_PROMPT=You are a helpful AI assistant focused on customer service. Keep your answers short and conversational, you are speaking over the phone.

# Speech-to-text. Vacío = se elige solo según AGENT_LANGUAGES:
#   flux-general-en    un solo idioma, inglés
#   flux-general-multi cualquier otro caso, con language_hints
# Escotilla de salida: nova-3 (sin turn awareness, pero admite code-switching).
LISTEN_MODEL=

# LLM. THINK_PROVIDER acepta:
#   open_ai / anthropic / google   el LLM que incluye Deepgram (sin clave propia)
#   digitalocean                   tus modelos en DigitalOcean Serverless Inference
#   (o deja el proveedor y añade THINK_ENDPOINT_URL + THINK_API_KEY para
#    cualquier otro servicio compatible con OpenAI)
THINK_PROVIDER=open_ai
THINK_MODEL=gpt-4o-mini
THINK_TEMPERATURE=0.7

# Solo con THINK_PROVIDER=digitalocean. La clave se crea en la consola de
# DigitalOcean, en Gradient AI -> Serverless Inference -> Model access keys.
# Ojo: quien llama al LLM es Deepgram, no este servidor, así que esta clave
# viaja hasta ellos dentro del mensaje Settings.
# Mira qué modelos tienes disponibles con:  npm run models
DIGITALOCEAN_MODEL_ACCESS_KEY=

# Para cualquier otro endpoint compatible con OpenAI (tiene que ser público:
# lo llama Deepgram desde fuera, no este proceso).
THINK_ENDPOINT_URL=
THINK_API_KEY=

# Text-to-speech. Para es+en tiene que ser una de las cinco voces de Aura-2
# que alternan los dos idiomas dentro de una misma frase:
#   aura-2-aquila-es   masculina — expresiva, entusiasta, cercana
#   aura-2-carina-es   femenina  — profesional, enérgica, segura
#   aura-2-diana-es    femenina  — profesional, expresiva, resolutiva
#   aura-2-javier-es   masculina — cercana, profesional, tranquila
#   aura-2-selena-es   femenina  — natural, amable, cercana
# El servidor avisa al arrancar si la voz no encaja con AGENT_LANGUAGES.
SPEAK_MODEL=aura-2-diana-es
